---
import { SOCIALS, SOCIAL_ICONS } from "../../config";
import { getCollection } from "astro:content";
import Icon from "../ui/Icon.astro";
import { Image } from 'astro:assets';

const activeSocials = SOCIALS.filter((s) => s.isActive);
const iconSocials = activeSocials.filter((social) => social.name !== "Mail");
const emailLink = activeSocials.find((social) => social.name === "Mail" && social.href.startsWith("mailto:"));
const emailAddress = emailLink?.href.slice("mailto:".length).split("?")[0];
const bioCollection = await getCollection("bio");
const bio = bioCollection[0]?.data;
---

<aside class="sidebar max-lg:flex-row max-lg:flex-wrap max-lg:gap-3 max-md:gap-2">
    <div class="flex flex-col items-center text-center max-lg:flex-row max-lg:text-left max-lg:gap-3 max-lg:items-center max-md:gap-2">
        {bio?.avatar && (
            <Image
                src={`/${bio.avatar}`}
                alt={`Avatar of ${bio.name}`}
                width={160} /* Maximum width in global.css for sidebar-avatar class */
                height={160}
                densities={[1.5, 2]} 
                format="webp"
                class="sidebar-avatar lg:mb-4"
                loading="eager"
            />
        )}
        <div class="flex flex-col items-center max-lg:items-start">
            {bio?.name && <h1 class="sidebar-name">{bio.name}</h1>}
            {bio?.institution && (
                <p class="sidebar-info">
                    <Icon name="Institution" size={16} class="shrink-0" />
                    {bio.institution}
                </p>
            )}
            {emailLink && emailAddress && (
                <a href={emailLink.href} class="sidebar-email mt-6">{emailAddress}</a>
            )}
            <div class="flex gap-1 flex-wrap items-center justify-center max-lg:justify-start mt-3">
                {iconSocials.map((social) => (
                    social.href.trim() ? <a
                        href={social.href.trim()}
                        aria-label={social.linkTitle}
                        title={social.linkTitle}
                        target="_blank"
                        rel="noreferrer"
                        class="social-link"
                    >
                        <Icon name={SOCIAL_ICONS[social.name] || social.name} size={24} />
                    </a> : <span
                        class="social-link opacity-50"
                        role="link"
                        aria-disabled="true"
                        aria-label={`${social.name} (link coming soon)`}
                        title={`${social.name} (link coming soon)`}
                    >
                        <Icon name={SOCIAL_ICONS[social.name] || social.name} size={24} />
                    </span>
                ))}
            </div>
        </div>
    </div>
</aside>
