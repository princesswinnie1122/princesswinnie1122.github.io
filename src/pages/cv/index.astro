---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PAGES } from "../../config";

if (PAGES.cv.isActive === false) {
    return Astro.redirect("/404");
}

const cvEntry = await getEntry("cv", "cv");
if (!cvEntry) {
    throw new Error("CV content not found. Please ensure src/content/cv.md exists.");
}

const { pdfUrl } = cvEntry.data;
const viewerUrl = pdfUrl ? `${pdfUrl.split("#")[0]}#toolbar=1&navpanes=0&view=FitH` : undefined;
---

<BaseLayout title={PAGES.cv.title}>
    <header class="page-header">
        <h1 class="page-title">{PAGES.cv.title}</h1>
    </header>

    {pdfUrl ? (
        <section aria-label="CV PDF" class="cv-document">
            <iframe
                src={viewerUrl}
                title="Winnie Sheng's curriculum vitae (PDF)"
                class="cv-pdf-viewer"
            />
            <p class="cv-pdf-open">
                <a href={pdfUrl} target="_blank" rel="noopener noreferrer" data-astro-reload>
                    Open PDF in a new tab
                </a>
            </p>
        </section>
    ) : (
        <p>CV coming soon.</p>
    )}
</BaseLayout>
